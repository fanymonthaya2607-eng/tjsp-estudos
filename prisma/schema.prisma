// ==========================================================================
// TJSP Estudos — Schema do banco de dados (PostgreSQL + Prisma)
// ==========================================================================
// Este schema modela toda a plataforma: editais versionados, matérias,
// assuntos, questões (oficiais, inéditas, adaptadas), respostas dos
// usuários, progresso, repetição espaçada, simulados e gamificação.
//
// IMPORTANTE: rode `npx prisma generate` e `npx prisma migrate dev` na sua
// máquina (ou deixe a Vercel rodar no build) — este sandbox de desenvolvimento
// não tem acesso de rede aos binários do Prisma, mas isso não afeta o uso
// normal do projeto fora daqui.
// ==========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================================
// AUTENTICAÇÃO (NextAuth / Auth.js — modelos padrão do @auth/prisma-adapter)
// ==========================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  answers          UserAnswer[]
  questionProgress UserQuestionProgress[]
  studySessions    StudySession[]
  simuladoAttempts SimuladoAttempt[]
  achievements     UserAchievement[]
  streak           UserStreak?
  savedQuestions   SavedQuestion[]
  tutorMessages    TutorMessage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==========================================================================
// EDITAL / ESTRUTURA CURRICULAR (versionável, sem hardcode)
// ==========================================================================

// Cada edição de concurso (ex.: "TJSP Escrevente 2026") é uma versão
// independente do edital. Criar uma nova edição NUNCA apaga dados antigos.
model ExamEdition {
  id          String    @id @default(cuid())
  examName    String // "TJSP Escrevente Técnico Judiciário"
  edition     String // "2026"
  organizer   String    @default("VUNESP") // banca organizadora
  description String?   @db.Text
  isActive    Boolean   @default(true) // edição vigente usada por padrão
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subjects          Subject[]
  simuladoTemplates SimuladoTemplate[]

  @@unique([examName, edition])
  @@map("exam_editions")
}

model Subject {
  id            String   @id @default(cuid())
  examEditionId String
  name          String // "Língua Portuguesa"
  slug          String
  order         Int      @default(0)
  weight        Int      @default(1) // peso/importância na prova
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examEdition ExamEdition @relation(fields: [examEditionId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@unique([examEditionId, slug])
  @@index([examEditionId])
  @@map("subjects")
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  name      String // "Interpretação de Texto"
  slug      String
  order     Int      @default(0)
  incidence Int      @default(0) // frequência histórica em provas (0-100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subtopics Subtopic[]
  questions Question[]
  content   TopicContent?

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@map("topics")
}

model Subtopic {
  id        String   @id @default(cuid())
  topicId   String
  name      String // "Inferência"
  slug      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([topicId, slug])
  @@index([topicId])
  @@map("subtopics")
}

// Conteúdo de apoio de um assunto: resumo, conceitos, leis, erros comuns, dicas.
model TopicContent {
  id             String   @id @default(cuid())
  topicId        String   @unique
  summary        String   @db.Text
  keyConcepts    Json // string[]
  relatedLaws    Json? // string[]
  commonMistakes Json? // string[]
  tips           Json? // string[]
  updatedAt      DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("topic_contents")
}

// ==========================================================================
// QUESTÕES
// ==========================================================================

enum QuestionOrigin {
  OFICIAL // prova real, mantém dados de origem
  INEDITA // gerada pelo sistema/IA, nunca apresentada como oficial
  ADAPTADA // baseada em conceito real, com novo enunciado/alternativas
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PENDING_REVIEW // aguardando revisão da IA revisora / admin
  APPROVED
  REJECTED
}

model Question {
  id         String  @id @default(cuid())
  topicId    String
  subtopicId String?

  statement    String         @db.Text
  origin       QuestionOrigin @default(INEDITA)
  difficulty   Difficulty     @default(MEDIUM)
  status       QuestionStatus @default(APPROVED)
  questionType String         @default("multipla_escolha") // multipla_escolha, certo_errado, etc.

  explanation String  @db.Text // explicação geral da resposta correta
  examTip     String? @db.Text // "dica de prova" / possível pegadinha

  // Metadados de origem (preenchidos quando origin = OFICIAL)
  source    String? // ex.: "VUNESP - Prova Oficial"
  examBoard String  @default("VUNESP")
  examName  String? // "TJSP Escrevente Técnico Judiciário"
  examYear  Int?

  tags Json // string[]

  // rastreabilidade de geração por IA (quando aplicável)
  generatedBy String? // modelo gerador, ex. "claude-sonnet"
  reviewedBy  String? // modelo/processo revisor
  reviewNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopic Subtopic? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)

  options  QuestionOption[]
  answers  UserAnswer[]
  progress UserQuestionProgress[]
  savedBy  SavedQuestion[]

  @@index([topicId])
  @@index([subtopicId])
  @@index([origin])
  @@index([difficulty])
  @@index([status])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  label      String // "A", "B", "C", "D", "E"
  text       String  @db.Text
  isCorrect  Boolean @default(false)
  // por que esta alternativa está certa/errada (mostrado na correção)
  rationale  String? @db.Text
  order      Int     @default(0)

  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  UserAnswer[]

  @@index([questionId])
  @@map("question_options")
}

// ==========================================================================
// RESPOSTAS, PROGRESSO E REPETIÇÃO ESPAÇADA
// ==========================================================================

model UserAnswer {
  id               String   @id @default(cuid())
  userId           String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean
  timeSpentSeconds Int      @default(0)
  answeredAt       DateTime @default(now())

  studySessionId    String?
  simuladoAttemptId String?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption  QuestionOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  studySession    StudySession?    @relation(fields: [studySessionId], references: [id], onDelete: SetNull)
  simuladoAttempt SimuladoAttempt? @relation(fields: [simuladoAttemptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([questionId])
  @@index([userId, isCorrect])
  @@map("user_answers")
}

enum ReviewStage {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

// Estado de repetição espaçada por par (usuário, questão)
model UserQuestionProgress {
  id               String      @id @default(cuid())
  userId           String
  questionId       String
  timesAnswered    Int         @default(0)
  timesCorrect     Int         @default(0)
  stage            ReviewStage @default(NEW)
  lastAnsweredAt   DateTime?
  nextReviewAt     DateTime?
  easeIntervalDays Int         @default(1)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
  @@map("user_question_progress")
}

model SavedQuestion {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("saved_questions")
}

// ==========================================================================
// SESSÕES DE ESTUDO
// ==========================================================================

enum StudyMode {
  QUICK_STUDY // "Estudar agora"
  FREE // Estudo livre
  ERROR_REVIEW // Revisão de erros
  HARD_QUESTIONS // Questões difíceis
  SMART_REVIEW // Revisão inteligente
  SIMULADO
  VUNESP_TRAINING // Treino VUNESP
  DAILY_CHALLENGE // Desafio diário
  TOPIC_TRAINING // Treino de um assunto específico
}

model StudySession {
  id             String    @id @default(cuid())
  userId         String
  mode           StudyMode
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  totalQuestions Int       @default(0)
  correctCount   Int       @default(0)

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers UserAnswer[]

  @@index([userId])
  @@map("study_sessions")
}

// ==========================================================================
// SIMULADOS
// ==========================================================================

model SimuladoTemplate {
  id               String   @id @default(cuid())
  examEditionId    String
  name             String
  description      String?  @db.Text
  totalQuestions   Int
  timeLimitMinutes Int
  // distribuição por matéria: { "subjectId": quantidade }
  distribution     Json
  officialRatio    Float    @default(0.3) // proporção de questões oficiais quando disponíveis
  createdAt        DateTime @default(now())

  examEdition ExamEdition       @relation(fields: [examEditionId], references: [id], onDelete: Cascade)
  attempts    SimuladoAttempt[]

  @@map("simulado_templates")
}

model SimuladoAttempt {
  id                 String    @id @default(cuid())
  userId             String
  simuladoTemplateId String
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  totalQuestions     Int       @default(0)
  correctCount       Int       @default(0)
  scorePercent       Float?
  timeSpentSeconds   Int       @default(0)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template SimuladoTemplate @relation(fields: [simuladoTemplateId], references: [id], onDelete: Cascade)
  answers  UserAnswer[]

  @@index([userId])
  @@map("simulado_attempts")
}

// ==========================================================================
// GAMIFICAÇÃO
// ==========================================================================

model UserStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime?
  xp            Int       @default(0)
  level         Int       @default(1)
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

model Achievement {
  id          String @id @default(cuid())
  code        String @unique // "100_QUESTOES", "7_DIAS_SEGUIDOS"
  title       String
  description String
  icon        String @default("trophy")
  // regra de desbloqueio (avaliada pelo backend), ex.: { "type": "questions_answered", "value": 100 }
  criteria    Json

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ==========================================================================
// PROFESSOR IA (histórico de conversas contextualizadas)
// ==========================================================================

model TutorMessage {
  id         String   @id @default(cuid())
  userId     String
  questionId String? // questão de contexto, se houver
  role       String // "user" | "assistant"
  content    String   @db.Text
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tutor_messages")
}
